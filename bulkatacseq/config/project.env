# 小鼠 GRCm39，独立两组；每行必须对应独立生物学单位。
ATAC_SAMPLES="${ATAC_SAMPLES:-${TEMPLATE_ROOT}/config/samples.tsv}"
ATAC_DESIGN="${ATAC_DESIGN:-independent_two_group}"
ATAC_ASSEMBLY="${ATAC_ASSEMBLY:-GRCm39}"
ATAC_LIBRARY_TYPE="${ATAC_LIBRARY_TYPE:-paired_end}"
ATAC_TISSUE="${ATAC_TISSUE:-tissue}"
ATAC_ENABLE_MULTIOMICS="${ATAC_ENABLE_MULTIOMICS:-0}"
ATAC_ENABLE_FOOTPRINT="${ATAC_ENABLE_FOOTPRINT:-0}"
ATAC_ENABLE_CONSERVATION="${ATAC_ENABLE_CONSERVATION:-0}"
# ---------- A. 项目、样本与参考基因组 ----------
# 项目工作目录；默认是本脚本所在目录。示例：WORK_DIR=/data/atac/Mus/liver
WORK_DIR="$TEMPLATE_ROOT"
# 样本表路径。示例：READS_INFO=/data/atac/Mus/liver/01rawdata/reads_info.txt
READS_INFO="$ATAC_SAMPLES"

# 参考文件根目录。示例：REF_DIR=/data/reference/GRCm39
REF_DIR="${REF_DIR:-${TEMPLATE_ROOT}/reference/GRCm39}"
# Bowtie2 index 前缀，不含 .1.bt2 等后缀。示例：REF_GENOME_INDEX=/ref/GRCm39/Mus_musculus.GRCm39
REF_GENOME_INDEX="${REF_GENOME_INDEX:-$REF_DIR/Mus_musculus.GRCm39}"
# mm39 blacklist BED。示例：BLACKLIST_BED=/ref/GRCm39/mm39.blacklist.bed
BLACKLIST_BED="${BLACKLIST_BED:-$REF_DIR/mm39.blacklist.bed}"
# mm39 TSS BED。示例：TSS_BED=/ref/GRCm39/mm39.refGene.TSS.bed
TSS_BED="${TSS_BED:-$REF_DIR/mm39.refGene.TSS.bed}"
# 染色体长度文件。示例：CHROM_SIZE=/ref/GRCm39/mm39.chrom.sizes
CHROM_SIZE="${CHROM_SIZE:-$REF_DIR/mm39.chrom.sizes}"
# mm39 genome FASTA。示例：GENOME_FASTA=/ref/GRCm39/genome.fa
GENOME_FASTA="${GENOME_FASTA:-$REF_DIR/Mus_musculus.GRCm39.dna.primary_assembly.fa}"
# 基因注释 GTF。示例：GENE_GTF=/ref/GRCm39/Mus_musculus.GRCm39.115.gtf
GENE_GTF="${GENE_GTF:-$REF_DIR/Mus_musculus.GRCm39.115.gtf}"

# ---------- B. 资源与默认运行范围 ----------
# 单个工具线程数；正整数。示例：THREADS=16
THREADS="${THREADS:-2}"
# 同时处理的样本数；总 CPU 约为 THREADS×PARALLEL_SAMPLES。示例：PARALLEL_SAMPLES=1
PARALLEL_SAMPLES="${PARALLEL_SAMPLES:-1}"

# ---------- C. FASTQ、比对与过滤阈值 ----------
# fastp 保留的最短 read 长度（bp）。示例：FASTP_MIN_LENGTH=25
FASTP_MIN_LENGTH="${FASTP_MIN_LENGTH:-30}"
# fastp 滑窗大小（bp）。示例：FASTP_CUT_WINDOW_SIZE=4
FASTP_CUT_WINDOW_SIZE="${FASTP_CUT_WINDOW_SIZE:-4}"
# fastp 滑窗平均质量阈值。示例：FASTP_CUT_MEAN_QUALITY=20
FASTP_CUT_MEAN_QUALITY="${FASTP_CUT_MEAN_QUALITY:-20}"
# Bowtie2 paired-end 最大 fragment 长度（-X，bp）。示例：BOWTIE2_MAX_FRAGMENT=1500
BOWTIE2_MAX_FRAGMENT="${BOWTIE2_MAX_FRAGMENT:-2000}"
# final BAM 最低 MAPQ。示例：ATAC_MAPQ=40
ATAC_MAPQ="${ATAC_MAPQ:-30}"
# samtools 排除 flag；1804 排除 unmapped、mate-unmapped、secondary、QC-fail、duplicate。
# duplicate-marked BAM 在 Picard 后另行保留；一般不要修改。示例：ATAC_SAMTOOLS_EXCLUDE_FLAGS=1804
ATAC_SAMTOOLS_EXCLUDE_FLAGS="${ATAC_SAMTOOLS_EXCLUDE_FLAGS:-1804}"

# ---------- D. Peak calling、BigWig 与 TSS ----------
# 主 sample peaks 的 MACS2 q-value。示例：ATAC_MACS2_QVALUE=0.01
ATAC_MACS2_QVALUE="${ATAC_MACS2_QVALUE:-0.05}"
# RPGC effective genome size；默认 mm39。示例：ATAC_EFFECTIVE_GENOME_SIZE=2652783500
ATAC_EFFECTIVE_GENOME_SIZE="${ATAC_EFFECTIVE_GENOME_SIZE:-2652783500}"
# RPGC bigWig bin size（bp）。示例：ATAC_BIGWIG_BIN_SIZE=25
ATAC_BIGWIG_BIN_SIZE="${ATAC_BIGWIG_BIN_SIZE:-10}"
# deepTools TSS 上下游窗口（bp）。示例：ATAC_TSS_FLANK=3000
ATAC_TSS_FLANK="${ATAC_TSS_FLANK:-2000}"
# deepTools 热图颜色，逗号分隔；与 rnaseq/liver 一致：reference 蓝→中间黄→comparison 珊瑚红。
# 示例：ATAC_DEEPTOOLS_HEATMAP_COLORS='#A1C9F4,#FDFFB6,#FF9F9B'
ATAC_DEEPTOOLS_HEATMAP_COLORS="${ATAC_DEEPTOOLS_HEATMAP_COLORS:-#A1C9F4,#FDFFB6,#FF9F9B}"
# 是否额外生成 raw MACS2 bigWig：1=生成，0=跳过。示例：RAW_MACS2_BIGWIG=0
RAW_MACS2_BIGWIG="${RAW_MACS2_BIGWIG:-1}"

# ---------- E. ENCODE-style IDR ----------
# relaxed peak 的 MACS2 p-value。示例：ATAC_IDR_MACS2_PVALUE=0.01
ATAC_IDR_MACS2_PVALUE="${ATAC_IDR_MACS2_PVALUE:-0.01}"
# thresholded peak 的全局 IDR 阈值。示例：ATAC_IDR_THRESHOLD=0.05
ATAC_IDR_THRESHOLD="${ATAC_IDR_THRESHOLD:-0.05}"
# 伪重复随机种子；固定可保证可重复。示例：ATAC_IDR_SEED=20260714
ATAC_IDR_SEED="${ATAC_IDR_SEED:-20260714}"
# 是否保留伪重复 BAM：1=保留，0=完成后清理。示例：ATAC_KEEP_IDR_INTERMEDIATES=1
ATAC_KEEP_IDR_INTERMEDIATES="${ATAC_KEEP_IDR_INTERMEDIATES:-1}"

# ---------- F. 可选增强分析 ----------
# ataqv organism 名称；小鼠使用 mouse。示例：ATAQV_ORGANISM=mouse
ATAQV_ORGANISM="${ATAQV_ORGANISM:-mouse}"
# 追加给 ataqv 的参数；无需要留空，含空格时加引号。示例：ATAQV_EXTRA_ARGS='--verbose'
ATAQV_EXTRA_ARGS="${ATAQV_EXTRA_ARGS:-}"
# TOBIAS 输出目录。示例：TOBIAS_DIR=/data/atac/Mus/liver/07footprinting
TOBIAS_DIR="${TOBIAS_DIR:-$WORK_DIR/07footprinting}"
# TOBIAS motif MEME 文件。示例：TOBIAS_MOTIFS=/ref/motif/JASPAR2024.meme
TOBIAS_MOTIFS="${TOBIAS_MOTIFS:-$REF_DIR/motif/JASPAR2020_CORE_vertebrates.meme}"
# TOBIAS 比较组前缀，需与样本表一致。示例：TOBIAS_PREFIX_COMPARISON=comparison
TOBIAS_PREFIX_COMPARISON="${TOBIAS_PREFIX_COMPARISON:-comparison}"
# TOBIAS 参考组前缀，需与样本表一致。示例：TOBIAS_PREFIX_REFERENCE=reference
TOBIAS_PREFIX_REFERENCE="${TOBIAS_PREFIX_REFERENCE:-reference}"

# ---------- G. 软件环境与命令 ----------
# MACS2/deepTools 环境 bin 目录；默认使用迁移工具包的统一现代环境。
MACS2_ENV="${MACS2_ENV:-}"
# IDR 环境 bin 目录；留空则从 PATH 查找。示例：IDR_ENV=/opt/conda/envs/idr/bin
IDR_ENV="${IDR_ENV:-}"
# TOBIAS 环境 bin 目录；默认使用同一个现代环境。
TOBIAS_ENV="${TOBIAS_ENV:-}"
# ataqv 环境 bin 目录；留空则从 PATH 查找。示例：ATAQV_ENV=/opt/conda/envs/ataqv/bin
ATAQV_ENV="${ATAQV_ENV:-}"
# featureCounts 环境 bin 目录；留空则从 PATH 查找。示例：FEATURECOUNTS_ENV=/opt/subread/bin
FEATURECOUNTS_ENV="${FEATURECOUNTS_ENV:-}"
# MACS2 命令覆盖；通常留空。示例：MACS2_CMD=/opt/bin/macs2
MACS2_CMD="${MACS2_CMD:-}"
# bamCoverage 命令覆盖；通常留空。示例：BAMCOVERAGE_CMD=/opt/bin/bamCoverage
BAMCOVERAGE_CMD="${BAMCOVERAGE_CMD:-}"
# computeMatrix 命令覆盖；通常留空。示例：COMPUTEMATRIX_CMD=/opt/bin/computeMatrix
COMPUTEMATRIX_CMD="${COMPUTEMATRIX_CMD:-}"
# plotProfile 命令覆盖；通常留空。示例：PLOTPROFILE_CMD=/opt/bin/plotProfile
PLOTPROFILE_CMD="${PLOTPROFILE_CMD:-}"
# plotHeatmap 命令覆盖；通常留空。示例：PLOTHEATMAP_CMD=/opt/bin/plotHeatmap
PLOTHEATMAP_CMD="${PLOTHEATMAP_CMD:-}"
# idr 命令覆盖；通常留空。示例：IDR_CMD=/opt/bin/idr
IDR_CMD="${IDR_CMD:-}"
# TOBIAS 命令覆盖；通常留空。示例：TOBIAS_CMD=/opt/bin/TOBIAS
TOBIAS_CMD="${TOBIAS_CMD:-}"
# ataqv 命令覆盖；通常留空。示例：ATAQV_CMD=/opt/bin/ataqv
ATAQV_CMD="${ATAQV_CMD:-}"
# featureCounts 命令覆盖；通常留空。示例：FEATURECOUNTS_CMD=/opt/bin/featureCounts
FEATURECOUNTS_CMD="${FEATURECOUNTS_CMD:-}"
# bedGraphToBigWig 命令覆盖；通常留空。示例：BEDGRAPHTOBIGWIG_CMD=/opt/bin/bedGraphToBigWig
BEDGRAPHTOBIGWIG_CMD="${BEDGRAPHTOBIGWIG_CMD:-}"
# Picard 命令覆盖；可为 picard 可执行文件。示例：PICARD_CMD=/opt/bin/picard
PICARD_CMD="${PICARD_CMD:-}"

# ---------- A. 输入目录与参考文件 ----------
# mm10→mm39 chain；留空使用项目默认文件。示例：ATAC_MM10_TO_MM39_CHAIN=/ref/mm10ToMm39.over.chain.gz
export ATAC_MM10_TO_MM39_CHAIN="${ATAC_MM10_TO_MM39_CHAIN:-}"
# Ensembl GTF；留空使用项目默认文件。示例：ATAC_ENSEMBL_GTF=/ref/Mus_musculus.GRCm39.115.gtf
export ATAC_ENSEMBL_GTF="${ATAC_ENSEMBL_GTF:-}"
# TxDb SQLite；留空时按 setup 默认策略加载。示例：ATAC_ENSEMBL_TXDB_SQLITE=/ref/mm39_txdb.sqlite
export ATAC_ENSEMBL_TXDB_SQLITE="${ATAC_ENSEMBL_TXDB_SQLITE:-}"

# ---------- B. 差异可及性主统计口径 ----------
# 主显著性指标：pvalue、padj 或 fdr；padj/fdr 均对应 DiffBind FDR。示例：ATAC_SIGNIFICANCE_MODE=fdr
export ATAC_SIGNIFICANCE_MODE="${ATAC_SIGNIFICANCE_MODE:-pvalue}"
# 主集合是否同时要求 FC：1=要求，0=不要求。示例：ATAC_PRIMARY_REQUIRE_FC=1
export ATAC_PRIMARY_REQUIRE_FC="${ATAC_PRIMARY_REQUIRE_FC:-0}"
# pvalue 主口径阈值，范围 (0,1]。示例：ATAC_PRIMARY_P_CUTOFF=0.01
export ATAC_PRIMARY_P_CUTOFF="${ATAC_PRIMARY_P_CUTOFF:-0.05}"
# FDR/padj 阈值，范围 (0,1]。示例：ATAC_DIFF_FDR_CUTOFF=0.1
export ATAC_DIFF_FDR_CUTOFF="${ATAC_DIFF_FDR_CUTOFF:-0.05}"
# |log2FC| 阈值；0.585 约等于 1.5 倍变化。示例：ATAC_DIFF_LOG2FC_CUTOFF=1
export ATAC_DIFF_LOG2FC_CUTOFF="${ATAC_DIFF_LOG2FC_CUTOFF:-0.585}"
# 探索性 nominal p-value 层；默认跟随主 pvalue 阈值。示例：ATAC_NOMINAL_P_CUTOFF=0.1
export ATAC_NOMINAL_P_CUTOFF="${ATAC_NOMINAL_P_CUTOFF:-$ATAC_PRIMARY_P_CUTOFF}"
# dba.count 的 RPKM filter（不是 raw count）。示例：ATAC_DIFFBIND_RPKM_FILTER=0.5
export ATAC_DIFFBIND_RPKM_FILTER="${ATAC_DIFFBIND_RPKM_FILTER:-1}"
# consensus peak 至少被多少样本支持；正整数。示例：ATAC_DIFFBIND_MIN_OVERLAP=2
export ATAC_DIFFBIND_MIN_OVERLAP="${ATAC_DIFFBIND_MIN_OVERLAP:-2}"
# 统一 summit 左右扩展宽度（bp）；0 表示不重定位。示例：ATAC_DIFFBIND_SUMMITS=250
export ATAC_DIFFBIND_SUMMITS="${ATAC_DIFFBIND_SUMMITS:-200}"
# DiffBind minCount；非负整数。示例：ATAC_DIFFBIND_MIN_COUNT=0
export ATAC_DIFFBIND_MIN_COUNT="${ATAC_DIFFBIND_MIN_COUNT:-0}"
# RPKM filter 的汇总函数：max 或 mean。示例：ATAC_DIFFBIND_FILTER_FUN=max
export ATAC_DIFFBIND_FILTER_FUN="${ATAC_DIFFBIND_FILTER_FUN:-max}"

# ---------- C. 对比方向 ----------
# 参考组；必须与 comparison 同时填写，不得留空。示例：ATAC_REFERENCE_GROUP=reference
export ATAC_REFERENCE_GROUP="${ATAC_REFERENCE_GROUP:-control}"
# 比较组；fold 方向为 comparison-reference。示例：ATAC_COMPARISON_GROUP=comparison
export ATAC_COMPARISON_GROUP="${ATAC_COMPARISON_GROUP:-treated}"

# ---------- D. 运行、缓存与图片 ----------
# 运行档位：full、report 或 quick；正式分析建议 full。示例：ATAC_RUN_PROFILE=report
export ATAC_RUN_PROFILE="${ATAC_RUN_PROFILE:-full}"
# 是否复用签名一致的步骤表/状态；签名不一致仍为 STALE。示例：ATAC_REUSE_STEP_TABLES=FALSE
export ATAC_REUSE_STEP_TABLES="${ATAC_REUSE_STEP_TABLES:-FALSE}"
# 可选步骤失败时是否中止；TRUE=中止。示例：ATAC_STRICT_MODE=TRUE
export ATAC_STRICT_MODE="${ATAC_STRICT_MODE:-FALSE}"
# knit 输出是否显示 R 代码。示例：ATAC_SHOW_CODE=TRUE
export ATAC_SHOW_CODE="${ATAC_SHOW_CODE:-FALSE}"
# 是否启用 knitr 自身缓存；通常保持 FALSE。示例：ATAC_CACHE_RESULTS=TRUE
export ATAC_CACHE_RESULTS="${ATAC_CACHE_RESULTS:-FALSE}"
# 是否生成常规轻量绘图。示例：ATAC_EMIT_LIGHT_PLOTS=FALSE
export ATAC_EMIT_LIGHT_PLOTS="${ATAC_EMIT_LIGHT_PLOTS:-TRUE}"
# 是否给 PDF 同时生成 PNG 预览。示例：ATAC_SAVE_PNG_PREVIEWS=FALSE
export ATAC_SAVE_PNG_PREVIEWS="${ATAC_SAVE_PNG_PREVIEWS:-TRUE}"
# PNG 分辨率（dpi，正整数）。示例：ATAC_PNG_DPI=150
export ATAC_PNG_DPI="${ATAC_PNG_DPI:-300}"
# 每个 PDF 最多转换的预览页数。示例：ATAC_PDF_PREVIEW_MAX_PAGES=2
export ATAC_PDF_PREVIEW_MAX_PAGES="${ATAC_PDF_PREVIEW_MAX_PAGES:-4}"
# 是否进行深度图片审计；会增加耗时。示例：ATAC_DEEP_PLOT_AUDIT=TRUE
export ATAC_DEEP_PLOT_AUDIT="${ATAC_DEEP_PLOT_AUDIT:-FALSE}"
# 轻量 setup 诊断开关；正式运行保持 FALSE。示例：ATAC_LIGHT_SETUP=TRUE bash run_rmd.sh --steps setup
export ATAC_LIGHT_SETUP="${ATAC_LIGHT_SETUP:-FALSE}"

# ---------- E. 可选重分析开关 ----------
# deepTools profiles：留空由 profile 决定，也可 TRUE/FALSE。示例：ATAC_RUN_DEEPTOOLS_PROFILES=FALSE
export ATAC_RUN_DEEPTOOLS_PROFILES="${ATAC_RUN_DEEPTOOLS_PROFILES:-}"
# MEME/Tomtom：留空由 profile 决定，也可 TRUE/FALSE。示例：ATAC_RUN_MEME_TOMTOM=TRUE
export ATAC_RUN_MEME_TOMTOM="${ATAC_RUN_MEME_TOMTOM:-}"
# MEME 可执行文件；留空从 PATH 查找。示例：ATAC_MEME_BIN=/opt/meme/bin/meme
export ATAC_MEME_BIN="${ATAC_MEME_BIN:-}"
# Tomtom 可执行文件；留空从 PATH 查找。示例：ATAC_TOMTOM_BIN=/opt/meme/bin/tomtom
export ATAC_TOMTOM_BIN="${ATAC_TOMTOM_BIN:-}"
# Tomtom motif 数据库；留空使用项目默认 JASPAR 库。示例：ATAC_TOMTOM_DB=/ref/JASPAR2024.meme
export ATAC_TOMTOM_DB="${ATAC_TOMTOM_DB:-}"
# 是否运行 phastCons 分析。示例：ATAC_RUN_PHASTCONS=TRUE
export ATAC_RUN_PHASTCONS="${ATAC_RUN_PHASTCONS:-FALSE}"
# 是否启用 liftover 相关基因注释。示例：ATAC_ENABLE_LIFTOVER_RELATED_GENE_ANNOTATION=TRUE
export ATAC_ENABLE_LIFTOVER_RELATED_GENE_ANNOTATION="${ATAC_ENABLE_LIFTOVER_RELATED_GENE_ANNOTATION:-FALSE}"

# ---------- F. 小样本/证据步骤最低数量 ----------
# footprint 分析要求的最少 PrimaryDiffPeak 数。示例：ATAC_FOOTPRINT_MIN_PRIMARY_PEAKS=100
export ATAC_FOOTPRINT_MIN_PRIMARY_PEAKS="${ATAC_FOOTPRINT_MIN_PRIMARY_PEAKS:-50}"
# WGBS 相关检验的最少配对位点数。示例：ATAC_WGBS_MIN_COR_N=20
export ATAC_WGBS_MIN_COR_N="${ATAC_WGBS_MIN_COR_N:-10}"


# 外部数据只读取显式声明文件；缺失可选项记录 MISSING。
ATAC_RNA_DE_FILE="${ATAC_RNA_DE_FILE:-}"
ATAC_RNA_EXPRESSION_FILE="${ATAC_RNA_EXPRESSION_FILE:-}"
ATAC_RNA_WGCNA_MODULE_FILE="${ATAC_RNA_WGCNA_MODULE_FILE:-}"
ATAC_RNA_WGCNA_TRAIT_FILE="${ATAC_RNA_WGCNA_TRAIT_FILE:-}"
ATAC_RNA_SPLICING_FILE="${ATAC_RNA_SPLICING_FILE:-}"
ATAC_RNA_GSEA_FILE="${ATAC_RNA_GSEA_FILE:-}"
ATAC_WGBS_DMR_FILE="${ATAC_WGBS_DMR_FILE:-}"
ATAC_WGBS_GENE_FILE="${ATAC_WGBS_GENE_FILE:-}"
ATAC_WGBS_KEGG_FILE="${ATAC_WGBS_KEGG_FILE:-}"
ATAC_WGBS_LOCI_FILE="${ATAC_WGBS_LOCI_FILE:-}"

# bam: 原生 DiffBind；counts: 给定 consensus 原始片段整数矩阵，原区间 DESeq2。
ATAC_INPUT_MODE="${ATAC_INPUT_MODE:-bam}"
ATAC_COUNTS_FILE="${ATAC_COUNTS_FILE:-}"
ATAC_COUNTS_MIN_TOTAL="${ATAC_COUNTS_MIN_TOTAL:-10}"
ATAC_COUNTS_SEED="${ATAC_COUNTS_SEED:-20260929}"

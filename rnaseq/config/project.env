# 集中参数；所有入口自动读取，可用 RNASEQ_CONFIG 指定另一文件。路径相对复制后的项目根目录。
RNASEQ_INPUT_MODE=fastq
RNASEQ_SAMPLES_TSV=config/samples.tsv
RNASEQ_COUNTS_FILE=rawdata/counts.tsv
RNASEQ_DESIGN=independent_two_group
RNASEQ_GROUP1=control
RNASEQ_GROUP2=treatment
RNASEQ_SPECIES=mouse
RNASEQ_LIBRARY_STRANDEDNESS=unstranded
RNASEQ_SEED=1
RNASEQ_DE_USE_PADJ=false
RNASEQ_DE_PVALUE_CUTOFF=0.05
RNASEQ_DE_LOG2FC_CUTOFF=1
RNASEQ_ENABLED_MODULES="1 2 3 4 5"
RNASEQ_IMMUNE_APPLICABLE=false
# 扩展模块需先配置相应输入；16 仅在组织/参考适用时启用。
RNASEQ_THIRD_METHODS=rmats
RNASEQ_THIRD_EXTRA_METHODS=""
REFERENCE_DIR=reference
HISAT2_INDEX=reference/genome
GTF_FILE=reference/genes.gtf
GENOME_FASTA=reference/genome.fa
STRING_INPUT_DIR=reference/ppi
THREADS=8
FASTP_BIN=fastp
HISAT2_BIN=hisat2
SAMTOOLS_BIN=samtools
RSCRIPT_BIN=Rscript
PYTHON_BIN=python3
SALMON_BIN=salmon

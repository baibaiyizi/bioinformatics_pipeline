# Shell variables, sourced and exported by the entrypoints. Relative paths use template root.
PROJECT_SPECIES='Mus musculus'
PROJECT_HOST_LABEL='mouse'
PROJECT_STAGE='configured_tissue'
PROJECT_CONTRAST_BASELINE='control'
PROJECT_CONTRAST_CASE='case'
MIRNA_PREFIX='mmu'
MULTIMIR_ORG='mmu'
KEGG_ORGANISM='mmu'
MIRNA_TARGET_ORGDB_PACKAGE='org.Mm.eg.db'
MIRNA_TARGET_ORGDB_OBJECT='org.Mm.eg.db'
SAMPLES_TSV='config/samples.tsv'
SPORTS_RESULT_DIR='sportsresult'
ANALYSIS_ROOT='result'
R_SCRIPT='Rscript'
REPORT_FIGURES=1
RUN_INFERENCE=0
DE_SIGNIFICANCE='PVALUE'
RUN_TARGET_ENRICHMENT=0
MIRNA_TARGET_SOURCE='validated'
RUN_ENDOSIRNA=0
ENDOSIRNA_REFS=''
ENDOSIRNA_REFERENCE_TSV=''
# Set exact programs/references before raw FASTQ execution; no project-path defaults.
SPORTS_PL='tools/sports1.1/source/sports.pl'
REFERENCE_ROOT='reference'
DB_ROOT='reference/smallrna'
GENOME_FASTA='reference/genome.fa'
GENOME_BASE='reference/genome'
MIRNA_BASE='reference/smallrna/miRNA'
RRNA_BASE='reference/smallrna/rRNA'
TRNA_BASE='reference/smallrna/tRNA'
TRNA_MITO_BASE='reference/smallrna/mt_tRNA'
PIRNA_BASE='reference/smallrna/piRNA'
ENSEMBL_BASE='reference/smallrna/ncRNA'
RFAM_BASE='reference/smallrna/Rfam'
THREADS=8
PARALLEL_JOBS=2
INDEX_AWARE_SCHEDULING=1
INDEX_WARMUP_SAMPLES=1
MIN_LEN=15
MAX_LEN=45
MISMATCH=1
KEEP_INTERMEDIATE=1
KEEP_FASTQ=0
PRETRIM_FASTQ=1
TRIM_ADAPTER=0
# Set this from the actual library kit; empty prevents raw FASTQ execution.
ADAPTER3=''
CUTADAPT_NEXTSEQ_TRIM=0
CUTADAPT_QUALITY_CUTOFF=''

# 独立两组、小鼠 GRCm39。每行 sample 必须为一个独立生物学样本（混池是一个单位）。
WGBS_SAMPLES="${WGBS_SAMPLES:-${TEMPLATE_ROOT}/config/samples.tsv}"
WGBS_DESIGN="${WGBS_DESIGN:-independent_two_group}"
WGBS_ASSEMBLY="${WGBS_ASSEMBLY:-GRCm39}"
WGBS_TISSUE="${WGBS_TISSUE:-tissue}"
WGBS_REF_DIR="${WGBS_REF_DIR:-${TEMPLATE_ROOT}/reference/GRCm39}"
WGBS_FASTA="${WGBS_FASTA:-${WGBS_REF_DIR}/Mus_musculus.GRCm39.dna.primary_assembly.fa}"
WGBS_GTF="${WGBS_GTF:-${WGBS_REF_DIR}/Mus_musculus.GRCm39.115.gtf}"
WGBS_LIBRARY_TYPE="${WGBS_LIBRARY_TYPE:-directional}"
WGBS_INPUT_MODE="${WGBS_INPUT_MODE:-raw}" # raw / clean / cached，显式选择输入层级。
WGBS_ENABLE_SPERM="${WGBS_ENABLE_SPERM:-0}"
WGBS_ENABLE_MULTIOMICS="${WGBS_ENABLE_MULTIOMICS:-0}"
WGBS_RNA_SEQ_FILE="${WGBS_RNA_SEQ_FILE:-}"
WGBS_RNA_KEGG_FILE="${WGBS_RNA_KEGG_FILE:-}"
WGBS_ATAC_PEAK_DIR="${WGBS_ATAC_PEAK_DIR:-}"
WGBS_ATAC_DIFF_DIR="${WGBS_ATAC_DIFF_DIR:-}"
WGBS_QC_CORR_MAX_SITES="${WGBS_QC_CORR_MAX_SITES:-100000}"
WGBS_DSS_NCORES="${WGBS_DSS_NCORES:-2}"
WGBS_SKIP_DMRSEQ="${WGBS_SKIP_DMRSEQ:-1}"
# DMR 属于 DSS 区域聚合规则；以下 p 阈值不是区域 FDR。
WGBS_DMR_P_THRESHOLD="${WGBS_DMR_P_THRESHOLD:-0.05}"
WGBS_DMR_PCT_SIG="${WGBS_DMR_PCT_SIG:-0.5}"
WGBS_DMR_MINLEN="${WGBS_DMR_MINLEN:-50}"
WGBS_DMR_MINCG="${WGBS_DMR_MINCG:-5}"
WGBS_DMR_DELTA="${WGBS_DMR_DELTA:-0.10}"
WGBS_SEED="${WGBS_SEED:-20260929}"
# 可选参数集中配置。运行前可用同名环境变量覆盖，例如: WGBS_BISMARK_PARALLEL=4 bash run_upstream.sh --steps 3
WGBS_ENV_BIN="${WGBS_ENV_BIN:-}" # 若目录存在，优先使用统一 bio_tools 环境里的工具。
WGBS_BISMARK_PARALLEL="${WGBS_BISMARK_PARALLEL:-2}" # Bismark 拆分并行数（独立生效）；与 WGBS_BOWTIE2_THREADS 为乘性关系，总并发 ≈ 两者之积。
WGBS_BOWTIE2_THREADS="${WGBS_BOWTIE2_THREADS:-2}" # 传给 Bowtie2 的每进程线程数（始终生效，与 WGBS_BISMARK_PARALLEL 互不排斥）。
WGBS_BISMARK_USE_TEMP_DIR="${WGBS_BISMARK_USE_TEMP_DIR:-0}" # Bismark --parallel 模式是否显式指定 temp_${sample} 目录。
WGBS_WRITE_UNMAPPED="${WGBS_WRITE_UNMAPPED:-0}" # 是否输出 unmapped FASTQ；默认关闭以减少大文件和合并风险。
WGBS_SAMTOOLS_SORT_THREADS="${WGBS_SAMTOOLS_SORT_THREADS:-2}" # samtools sort 使用的线程数。
WGBS_REUSE_SORTED_BAM="${WGBS_REUSE_SORTED_BAM:-1}" # 已有 sample.sorted.bam 且 quickcheck 通过时是否复用。
WGBS_REUSE_METHYLKIT="${WGBS_REUSE_METHYLKIT:-1}" # 已有 sample_CpG.methylKit 时是否复用。
WGBS_RUN_BAM2NUC="${WGBS_RUN_BAM2NUC:-0}" # 是否运行 bam2nuc；该步骤会扫描 BAM，默认跳过。
WGBS_REUSE_BAM2NUC="${WGBS_REUSE_BAM2NUC:-1}" # 已有 bam2nuc done 标记时是否复用。
WGBS_RUN_MBIAS="${WGBS_RUN_MBIAS:-0}" # 是否生成 M-bias QC；该步骤会额外扫描 BAM，默认跳过。
WGBS_REUSE_MBIAS="${WGBS_REUSE_MBIAS:-1}" # 已有 M-bias 报告时是否复用。
WGBS_MBIAS_NAME_SORT_EXISTING_BAM="${WGBS_MBIAS_NAME_SORT_EXISTING_BAM:-0}" # 仅有 sorted BAM 时，是否临时 name-sort 后补做 M-bias。
WGBS_MBIAS_SORT_THREADS="${WGBS_MBIAS_SORT_THREADS:-2}" # M-bias 临时 name-sort 使用的线程数。
WGBS_RUN_INSERT_SIZE="${WGBS_RUN_INSERT_SIZE:-0}" # 是否运行 insert size 统计；该步骤会扫描 BAM，默认跳过。
WGBS_FULL_NONCG="${WGBS_FULL_NONCG:-0}" # 是否导出完整 CHG/CHH methylKit 文件，默认只保留 CpG。
WGBS_METHREAD_MINCOV="${WGBS_METHREAD_MINCOV:-4}" # methylKit::methRead 读取 CpG methylKit 文本的最小覆盖度。
WGBS_EXTRA_MINCOV_LEVELS="${WGBS_EXTRA_MINCOV_LEVELS:-}" # 逗号分隔的额外 mincov 缓存，例如 1,5,10；为空则不生成。
WGBS_DBSNP_VCF="${WGBS_DBSNP_VCF:-}" # step 14 使用的 dbSNP VCF/VCF.GZ；为空则跳过 SNP BED。

# 可选参数集中配置。运行前可用同名环境变量覆盖，例如: WGBS_SIGNIFICANCE_MODE=padj bash run_wgbs.sh --steps 5,8-9
WGBS_LOG_DIR="${WGBS_LOG_DIR:-${TEMPLATE_ROOT}/log}" # 下游运行日志目录。
WGBS_RMARKDOWN_QUIET="${WGBS_RMARKDOWN_QUIET:-0}" # 是否静默 rmarkdown::render 输出；默认保留详细日志。
WGBS_SIGNIFICANCE_MODE="${WGBS_SIGNIFICANCE_MODE:-pvalue}" # 下游 RNA/富集筛选口径: pvalue 或 padj。
# 差异比较方向为 COMPARISON_GROUP - REFERENCE_GROUP（comparison - reference）。
WGBS_REFERENCE_GROUP="${WGBS_REFERENCE_GROUP:-control}"
WGBS_COMPARISON_GROUP="${WGBS_COMPARISON_GROUP:-treated}"


WGBS_FASTQC_THREADS="${WGBS_FASTQC_THREADS:-2}"
WGBS_FASTP_THREADS="${WGBS_FASTP_THREADS:-2}"
WGBS_FASTP_QUALITY="${WGBS_FASTP_QUALITY:-30}"
WGBS_FASTP_UNQUALIFIED_PERCENT="${WGBS_FASTP_UNQUALIFIED_PERCENT:-40}"
WGBS_FASTP_MIN_LENGTH="${WGBS_FASTP_MIN_LENGTH:-50}"
# 精子专题需要已核验、注明 GRCm39 坐标来源的外部表，禁止使用未经核验的内置 ICR 坐标。
WGBS_SPERM_ICR_FILE="${WGBS_SPERM_ICR_FILE:-}"
WGBS_SPERMATOGENESIS_GENE_FILE="${WGBS_SPERMATOGENESIS_GENE_FILE:-}"

# 下游阈值与区域定义。
WGBS_RNA_P_THRESHOLD="${WGBS_RNA_P_THRESHOLD:-0.05}"
WGBS_RNA_FDR_THRESHOLD="${WGBS_RNA_FDR_THRESHOLD:-0.05}"
WGBS_RNA_LOG2FC_THRESHOLD="${WGBS_RNA_LOG2FC_THRESHOLD:-0.58}"
WGBS_ENRICHMENT_P_THRESHOLD="${WGBS_ENRICHMENT_P_THRESHOLD:-0.05}"
WGBS_ENRICHMENT_FDR_THRESHOLD="${WGBS_ENRICHMENT_FDR_THRESHOLD:-0.05}"
WGBS_DMR_DIS_MERGE="${WGBS_DMR_DIS_MERGE:-50}"
WGBS_DSS_SMOOTHING_SPAN="${WGBS_DSS_SMOOTHING_SPAN:-500}"
WGBS_PROMOTER_UPSTREAM="${WGBS_PROMOTER_UPSTREAM:-2000}"
WGBS_PROMOTER_DOWNSTREAM="${WGBS_PROMOTER_DOWNSTREAM:-2000}"
WGBS_DSS_SMOOTHING="${WGBS_DSS_SMOOTHING:-1}"
